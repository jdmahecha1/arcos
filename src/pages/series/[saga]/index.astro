---
import CoverCard from '../../../components/CoverCard.astro';
import Crest from '../../../components/Crest.astro';
import FogGroup from '../../../components/FogGroup.astro';
import SagaArt from '../../../components/SagaArt.astro';
import RelationGraph from '../../../components/RelationGraph';
import SaveBar from '../../../components/SaveBar';
import SavePanel from '../../../components/SavePanel';
import Spoiler from '../../../components/Spoiler.astro';
import Timeline from '../../../components/Timeline';
import Base from '../../../layouts/Base.astro';
import { getSagas } from '../../../lib/data';
import type { Saga } from '../../../lib/schema';
import { portraitSrc, SAGA_COVER } from '../../../lib/artwork';
import { airedYears, FORMAT_LABEL, seasonsInOrder } from '../../../lib/spoilers';
import { themeFor } from '../../../lib/themes';
import { characterUrl, url } from '../../../lib/url';

export function getStaticPaths() {
  return getSagas().map((saga) => ({ params: { saga: saga.id }, props: { saga } }));
}

interface Props {
  saga: Saga;
}

const { saga } = Astro.props;
const theme = themeFor(saga.id);
const seasons = seasonsInOrder(saga);
// Las portadas pueden adelantar la historia: cada una se revela al terminar la entrega anterior.
function coverMarker(saga: Saga, index: number) {
  const previous = saga.seasons.slice(0, index).findLast((s) => !s.optional) ?? saga.seasons[0];
  return { season: previous.id, arc: previous.arcs.length - 1 };
}
const years = airedYears(saga);
const known = saga.characters.filter((c) => !c.appears);
const later = saga.characters.filter((c) => c.appears);
const sections = [
  ['cronologia', 'Cronología'],
  ['personajes', 'Personajes'],
  ['relaciones', 'Relaciones'],
  ['temporadas', 'Temporadas'],
];
---

<Base title={saga.title} description={`${saga.tagline} ${saga.synopsis}`} theme={theme}>
  <header class="saga-hero">
    <SagaArt sagaId={saga.id} theme={theme} uid="hero" class="saga-hero__art" priority />
    <div class="wrap saga-hero__content">
      <CoverCard seasonId={SAGA_COVER[saga.id]} title={saga.seasons.find((g) => g.id === SAGA_COVER[saga.id])?.title ?? saga.title} class="saga-hero__cover" priority />
      <nav aria-label="Ruta" class="crumbs"><a href={url()}>Series</a> / <span>{saga.title}</span></nav>
      <p class="saga-hero__meta">{saga.studio}, {saga.genre.toLowerCase()}, {years}</p>
      <h1>{saga.title}</h1>
      <p class="saga-hero__tagline">{saga.tagline}</p>
    </div>
  </header>

  <nav class="section-nav" aria-label="Secciones de la serie">
    <div class="wrap section-nav__inner">
      {sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
    </div>
  </nav>

  <div class="wrap saga-layout">
    <aside class="saga-layout__aside" data-pagefind-ignore="all">
      <SavePanel client:load saga={saga} />
    </aside>

    <div class="saga-layout__main">
      <p class="synopsis">{saga.synopsis}</p>

      <section id="cronologia" class="block" aria-labelledby="cronologia-titulo" data-pagefind-ignore="all">
        <h2 id="cronologia-titulo">Cronología</h2>
        <Timeline client:load saga={saga} />
      </section>

      <section id="personajes" class="block" aria-labelledby="personajes-titulo">
        <h2 id="personajes-titulo">Personajes</h2>
        <ul class="people">
          {
            known.map((c) => (
              <li>
                <a class="person" href={characterUrl(saga.id, c.id)}>
                  <Crest name={c.name} portrait={portraitSrc(saga.id, c.id)} />
                  <span class="person__text">
                    <span class="person__name">{c.name}</span>
                    <span class="person__role">{c.role}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        {
          later.length > 0 && (
            <FogGroup
              singular="personaje por conocer"
              plural="personajes por conocer"
              count={later.length}
              listClass="people people--later"
            >
              {later.map((c) => (
                <Spoiler as="li" saga={saga} at={c.appears!} label="Un personaje">
                  <a class="person" href={characterUrl(saga.id, c.id)}>
                    <Crest name={c.name} portrait={portraitSrc(saga.id, c.id)} />
                    <span class="person__text">
                      <span class="person__name">{c.name}</span>
                      <span class="person__role">{c.role}</span>
                    </span>
                  </a>
                </Spoiler>
              ))}
            </FogGroup>
          )
        }
      </section>

      <section id="relaciones" class="block" aria-labelledby="relaciones-titulo" data-pagefind-ignore="all">
        <h2 id="relaciones-titulo">Relaciones</h2>
        <RelationGraph client:idle saga={saga} portraits={Object.fromEntries(saga.characters.map((c) => [c.id, portraitSrc(saga.id, c.id) ?? '']))} />
      </section>

      <section id="temporadas" class="block" aria-labelledby="temporadas-titulo">
        <h2 id="temporadas-titulo">Temporadas, películas y manga</h2>
        <ol class="seasons">
          {
            seasons.map((season, i) => (
              <li>
                {i > 0 && season.format !== 'manga' ? (
                  <Spoiler saga={saga} at={coverMarker(saga, i)} label="Portada" compact>
                    <CoverCard seasonId={season.id} title={season.title} />
                  </Spoiler>
                ) : (
                  <CoverCard seasonId={season.id} title={season.title} />
                )}
                <span class="seasons__year">{season.year}</span>
                <span class="seasons__title">{season.title}</span>
                <span class="seasons__chapters">
                  {FORMAT_LABEL[season.format]}, {season.arcs.length} {season.arcs.length === 1 ? 'arco' : 'arcos'}
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <SaveBar client:load saga={saga} />
</Base>

<style>
  .saga-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(470px, 62dvh);
    overflow: hidden;
  }

  .saga-hero :global(.saga-hero__art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.saga-hero__art) {
        animation: hero-drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 600px;
      }
    }
  }

  @keyframes hero-drift {
    to {
      transform: translateY(18%) scale(1.06);
      opacity: 0.6;
    }
  }

  .saga-hero__content {
    position: relative;
    padding-block: var(--space-8) var(--space-6);
  }

  @media (min-width: 861px) {
    .saga-hero__content {
      padding-right: 260px;
    }
  }

  .crumbs {
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .crumbs a {
    color: var(--text);
  }

  .saga-hero__meta {
    margin-bottom: var(--space-2);
    color: var(--muted);
    font-size: var(--step-0);
  }

  .saga-hero h1 {
    margin-bottom: var(--space-2);
    text-shadow: 0 2px 24px color-mix(in oklab, var(--bg) 70%, transparent);
  }

  .saga-hero__tagline {
    max-width: 52ch;
    margin: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 500;
  }

  .section-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    border-bottom: 1px solid var(--line-soft);
    background: color-mix(in oklab, var(--bg) 90%, transparent);
    backdrop-filter: blur(12px);
  }

  .section-nav__inner {
    display: flex;
    gap: var(--space-1);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .section-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .section-nav a:hover {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .saga-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding-top: var(--space-6);
  }

  @media (min-width: 980px) {
    .saga-layout {
      grid-template-columns: 360px minmax(0, 1fr);
      gap: var(--space-7);
    }

    .saga-layout__aside {
      position: sticky;
      top: calc(var(--header-h) + 64px);
      max-height: calc(100dvh - var(--header-h) - 80px);
      overflow: hidden auto;
      scrollbar-width: thin;
    }
  }

  .synopsis {
    max-width: 65ch;
    color: var(--muted);
    font-size: var(--step-2);
    line-height: 1.55;
  }

  .block {
    margin-top: var(--space-7);
    scroll-margin-top: calc(var(--header-h) + 64px);
  }

  /* Global: la lista de personajes por conocer la pinta FogGroup, con su propio ámbito. */
  :global(.people) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
  }

  .person {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }

  .person:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .person__text {
    display: grid;
    min-width: 0;
  }

  .person__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.2;
  }

  .person__role {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.35;
  }

  /* Estantería: una portada por entrega, en orden de visionado. */
  .seasons {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr));
    gap: var(--space-5) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .seasons li {
    display: grid;
    align-content: start;
    gap: var(--space-1);
  }

  .seasons li :global(.cover-card) {
    margin-bottom: var(--space-2);
  }

  .seasons__year {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .seasons__title {
    font-weight: 600;
    line-height: 1.3;
  }

  .seasons__chapters {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* Portada de la serie en la cabecera. */
  .saga-hero__content :global(.saga-hero__cover) {
    position: absolute;
    right: 0;
    bottom: var(--space-6);
    width: 210px;
    transform: rotate(3deg);
  }

  @media (max-width: 860px) {
    .saga-hero__content :global(.saga-hero__cover) {
      position: static;
      width: 112px;
      margin-bottom: var(--space-4);
      transform: rotate(-2deg);
    }
  }
</style>
