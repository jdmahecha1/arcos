---
import { CompassIcon, MagnifyingGlassIcon } from '@phosphor-icons/react/dist/ssr';
import '../styles/global.css';
import ShieldToggle from '../components/ShieldToggle';
import { DEFAULT_THEME, themeStyle, type Theme } from '../lib/themes';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Identidad de la serie: colores de toda la página. */
  theme?: Theme;
  /** false en páginas cuyo contenido completo sería un spoiler: Pagefind no las indexa. */
  indexable?: boolean;
}

const { title, description, theme = DEFAULT_THEME, indexable = true } = Astro.props;
const fullTitle = title === 'Arcos' ? title : `${title} · Arcos`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content={theme.bg} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url('og.png'), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {!indexable && <meta name="robots" content="noindex" />}
  </head>
  <body style={themeStyle(theme)}>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href={url()} aria-label="Arcos, inicio">
          <svg viewBox="0 0 32 32" aria-hidden="true" class="brand__mark">
            <path d="M16 2 4 7v8c0 7.5 5.1 13.4 12 15 6.9-1.6 12-7.5 12-15V7L16 2Z" fill="currentColor" opacity=".18"></path>
            <path d="M16 2 4 7v8c0 7.5 5.1 13.4 12 15 6.9-1.6 12-7.5 12-15V7L16 2Z" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            <path d="M11 11h10M11 15.5h10M11 20h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
          <span>Arcos</span>
        </a>
        <nav aria-label="Principal" class="site-nav">
          <a href={url()} aria-current={path === url() ? 'page' : undefined}>
            <CompassIcon className="icon" aria-hidden="true" weight="duotone" />
            <span>Series</span>
          </a>
          <a href={url('buscar/')} aria-current={path === url('buscar/') ? 'page' : undefined}>
            <MagnifyingGlassIcon className="icon" aria-hidden="true" weight="bold" />
            <span>Buscar</span>
          </a>
        </nav>
        <ShieldToggle client:load />
      </div>
    </header>

    <main id="contenido" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>
          Proyecto de fans sin ánimo de lucro, sin relación con los autores, estudios ni editoriales de las series.
          Los nombres y el arte oficial pertenecen a sus dueños; los resúmenes son propios.
        </p>
        <nav aria-label="Pie de página" class="site-footer__links">
          <a href={url('acerca/')}>Cómo funciona el escudo</a>
          <a href={url('creditos/')}>Créditos de imágenes</a>
          <a href="https://github.com/jdmahecha1/arcos">Código en GitHub</a>
          <span>Hecho por <a href="https://github.com/jdmahecha1">toriikarii</a></span>
        </nav>
      </div>
    </footer>

    <script>
      import '../scripts/spoilers-dom';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .skip:focus {
    top: 12px;
  }

  /* z-index: 50 cabecera, 40 barra de sección, 30 barra inferior móvil. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line-soft);
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
      backdrop-filter: none;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-right: auto;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand__mark {
    width: 28px;
    height: 28px;
    color: var(--accent);
  }

  .site-nav {
    display: flex;
    gap: var(--space-1);
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--step-0);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }

  @media (max-width: 560px) {
    .brand span {
      display: none;
    }

    .site-nav a {
      padding: 0 var(--space-2);
    }
  }

  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line-soft);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-7);
  }

  .site-footer p {
    margin: 0;
    max-width: 70ch;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  @media (max-width: 979px) {
    .site-footer {
      padding-bottom: 72px;
    }
  }
</style>
