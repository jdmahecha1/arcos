---
import { coverSrc, landscapeFor, landscapeSrc, sagaCover } from '../lib/artwork';
import type { Theme } from '../lib/themes';
import { url } from '../lib/url';
import Landscape from './Landscape.astro';

interface Props {
  sagaId: string;
  theme: Theme;
  uid: string;
  class?: string;
  /**
   * "backdrop": una imagen del anime como fondo (decorativa); si la serie no tiene,
   * la portada ampliada y difuminada.
   * "cover": la portada nítida, recortada para llenar el espacio.
   */
  mode?: 'backdrop' | 'cover';
  priority?: boolean;
  fog?: boolean;
  /** Degradado hacia el fondo en la parte baja, para el texto que va encima. */
  scrim?: boolean;
  /** Ancho con que se muestra, para elegir la resolución del paisaje. */
  sizes?: string;
}

const { sagaId, theme, uid, class: className, mode = 'backdrop', priority = false, fog = true, scrim = true, sizes = '100vw' } = Astro.props;
const cover = sagaCover(sagaId);
const scenery = mode === 'backdrop' && landscapeFor(sagaId);
const loading = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : undefined;
---

<div class:list={['saga-art', `saga-art--${mode}`, className]}>
  {/* El paisaje queda debajo: es el respaldo si la portada falta o no carga. */}
  <Landscape seed={sagaId} theme={theme} uid={uid} class="saga-art__fallback" fog={fog && !cover} />
  {
    scenery ? (
      <img
        class="saga-art__img saga-art__scenery"
        src={url(landscapeSrc(sagaId, 960))}
        srcset={`${url(landscapeSrc(sagaId, 960))} 960w, ${url(landscapeSrc(sagaId, 1920))} 1920w`}
        sizes={sizes}
        alt=""
        aria-hidden="true"
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    ) : (
      cover && (
        <img
          class="saga-art__img"
          src={url(coverSrc(cover.seasonId))}
          width={cover.width}
          height={cover.height}
          alt=""
          aria-hidden="true"
          loading={loading}
          fetchpriority={fetchpriority}
          decoding="async"
        />
      )
    )
  }
  {scrim && <span class="saga-art__scrim" aria-hidden="true" />}
</div>

<style>
  .saga-art {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .saga-art :global(.saga-art__fallback),
  .saga-art__img,
  .saga-art__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .saga-art__img {
    object-fit: cover;
  }

  /* Fondo: la portada (pequeña) ampliada y difuminada, como un póster visto de lejos. */
  .saga-art--backdrop .saga-art__img:not(.saga-art__scenery) {
    filter: blur(26px) saturate(1.25);
    transform: scale(1.3);
    opacity: 0.6;
  }

  /* El paisaje, nítido pero algo apagado hacia el fondo de la saga para que el texto se lea. */
  .saga-art__scenery {
    filter: brightness(0.72);
  }

  .saga-art__scrim {
    background: linear-gradient(180deg, transparent 10%, color-mix(in oklab, var(--bg) 78%, transparent) 55%, var(--bg));
  }
</style>
